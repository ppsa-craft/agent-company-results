# vnstock-advisor Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# DATABASE (PostgreSQL 15 with TimescaleDB)
# =============================================================================
POSTGRES_USER=vnstock
POSTGRES_PASSWORD=vnstock
POSTGRES_DB=vnstock_advisor
DATABASE_URL=postgresql+asyncpg://vnstock:vnstock@localhost:5432/vnstock_advisor

# =============================================================================
# REDIS
# =============================================================================
REDIS_PASSWORD=vnstock
REDIS_URL=redis://:vnstock@localhost:6379/0

# =============================================================================
# JWT AUTHENTICATION
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# =============================================================================
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQD...
-----END PRIVATE KEY-----"

JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...
-----END PUBLIC KEY-----"

JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# DATA SOURCE API KEYS (at least one required for data-ingest service)
# =============================================================================
# Vnstock (Vietnam stock data) - https://vnstock.vn
VNSTOCK_API_KEY=

# Alpha Vantage (global market data) - https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Twelve Data (global market data) - https://twelvedata.com/
TWELVE_DATA_API_KEY=

# =============================================================================
# SERVICE PORTS (for local development)
# =============================================================================
DATA_INGEST_PORT=8001
ANALYSIS_ENGINE_PORT=8002
SUGGESTION_API_PORT=8003
WEB_UI_PORT=3000

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json