{
  "name": "simple-web-tools",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "esbuild": "^0.24.0",
    "vitest": "^2.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint apps/",
    "format": "prettier --write \"apps/**/*.js\""
  }
}
