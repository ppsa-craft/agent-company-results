{
  "name": "@vnstock/shared-typescript",
  "version": "0.1.0",
  "description": "Shared TypeScript types and Zod schemas for vnstock-advisor",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
